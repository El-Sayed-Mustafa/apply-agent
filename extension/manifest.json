{
  "manifest_version": 3,
  "name": "Apply Agent",
  "version": "0.4.0",
  "description": "Fills job application forms from your prepared answers. You review and press Submit yourself.",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "alarms",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8765/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://jobs.ashbyhq.com/*"
      ],
      "js": [
        "fill.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://job-boards.greenhouse.io/*",
        "https://job-boards.eu.greenhouse.io/*",
        "https://boards.greenhouse.io/*"
      ],
      "js": [
        "fill.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://jobs.lever.co/*",
        "https://jobs.eu.lever.co/*"
      ],
      "js": [
        "fill.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://wuzzuf.net/*",
        "https://*.bayt.com/*",
        "https://*.gulftalent.com/*",
        "https://*.indeed.com/*",
        "https://*.naukrigulf.com/*",
        "https://wellfound.com/*"
      ],
      "js": [
        "sitejobs.js",
        "sitejobs-content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
