# انسخ الملف ده لـ .env وحط القيم الحقيقية.
# ملف .env نفسه في .gitignore — عمره ما هيترفع على GitHub.
#
# هتلاقي الاتنين دول في:
#   Supabase → Project Settings → API

SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# ⚠️  service_role مش anon. ده مفتاح بيتخطى الـ RLS —
#     يفضل على جهازك وفي GitHub Secrets بس، ولا يتكتب في أي كود.
SUPABASE_SERVICE_KEY=eyJhbGciOi...

# اختياري: مسار مختلف لسجل الشركات
# REGISTRY_PATH=companies.yaml
